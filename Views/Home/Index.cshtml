@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1>Posts Cards</h1>
	<p>The posts cards displayed below are fetched from an API endpoint using JavaScript fetch method.</p>
    <p>That's why it takes a sec to load!'</p>
</div>

<div id="postCount">
    <script>
        fetch('/api/posts')
            .then(response => response.json())
            .then(data => {
                document.getElementById('postCount').innerText = `Total Posts: ${data.length}`;
            });
    </script>
</div>

<!-- Dynamically fetching posts from an API endpoint -->
<div id="posts-container">
        <script>
            fetch('/api/posts')
                .then(response => response.json())
                .then(posts => {
                    const postsContainer = document.getElementById('posts-container');
                    posts.forEach(post => {
                        const postCard = document.createElement('div');
                        postCard.classList.add('post-card');
                        postCard.innerHTML = `
                            <h2>${post.title}</h2>
                            <p>${post.body}</p>
                            <p><strong>Author:</strong> ${post.author}</p>
                        `;
                        postsContainer.appendChild(postCard);
                    });
                })
				.catch(error => console.error('Error fetching posts:', error));
        </script>
</div>